<?xml version="1.0"?>
<sdf version="1.6">
  <world name="workshop_demo">
    <physics type="ode"><max_step_size>0.001</max_step_size><real_time_update_rate>1000</real_time_update_rate><gravity>0 0 -9.81</gravity></physics>
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/gazebo</namespace>
      </ros>
      <update_rate>10.0</update_rate>
    </plugin>
    <scene>
    <ambient>0.7 0.7 0.7 1</ambient>
    <background>0.12 0.12 0.14 1</background><shadows>true</shadows>
    </scene>
    <!-- <scene>
    <ambient>0.55 0.55 0.55 1</ambient>
  <background>0.10 0.10 0.12 1</background>
    </scene> -->
    <light name="ceiling_light" type="point"><pose>0 0 5 0 0 0</pose><diffuse>0.9 0.9 0.9 1</diffuse><specular>0.2 0.2 0.2 1</specular><attenuation><range>20</range><constant>0.7</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation><cast_shadows>true</cast_shadows></light>
    <!-- <light name="fill_light" type="directional"><pose>0 0 6 0 0 0</pose><diffuse>0.55 0.55 0.55 1</diffuse><direction>-0.3 0.2 -1</direction><cast_shadows>false</cast_shadows></light> -->
    <!-- <light name="strip_left" type="spot"><pose>-2 0 3.05 0 0 0</pose><diffuse>0.85 0.88 0.92 1</diffuse><specular>0.15 0.15 0.15 1</specular><direction>0 0 -1</direction><spot><inner_angle>0.75</inner_angle><outer_angle>1.05</outer_angle><falloff>0.5</falloff></spot><attenuation><range>8</range><constant>0.7</constant><linear>0.03</linear><quadratic>0.005</quadratic></attenuation></light>
    <light name="strip_right" type="spot"><pose>2 0 3.05 0 0 0</pose><diffuse>0.85 0.88 0.92 1</diffuse><specular>0.15 0.15 0.15 1</specular><direction>0 0 -1</direction><spot><inner_angle>0.75</inner_angle><outer_angle>1.05</outer_angle><falloff>0.5</falloff></spot><attenuation><range>8</range><constant>0.7</constant><linear>0.03</linear><quadratic>0.005</quadratic></attenuation></light> -->
    <model name="workshop_room"><static>true</static><link name="room_link">
      <collision name="floor_col"><geometry><box><size>10 8 0.10</size></box></geometry><pose>0 0 -0.05 0 0 0</pose></collision>
      <!-- <visual name="floor_vis"><geometry><box><size>10 8 0.10</size></box></geometry><pose>0 0 -0.05 0 0 0</pose><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual> -->
      <visual name="floor_vis">
      <geometry><box><size>10 8 0.10</size></box></geometry>
      <pose>0 0 -0.05 0 0 0</pose>
      <material>
        <ambient>0.22 0.22 0.24 1</ambient>
        <diffuse>0.32 0.32 0.35 1</diffuse>
        <specular>0.08 0.08 0.08 1</specular>
      </material>
    </visual>
      <collision name="back_col"><geometry><box><size>10 0.10 3.2</size></box></geometry><pose>0 -4 1.6 0 0 0</pose></collision>
      <visual name="back_vis"><geometry><box><size>10 0.10 3.2</size></box></geometry><pose>0 -4 1.6 0 0 0</pose><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual>
      <collision name="left_col"><geometry><box><size>0.10 8 3.2</size></box></geometry><pose>-5 0 1.6 0 0 0</pose></collision>
      <visual name="left_vis"><geometry><box><size>0.10 8 3.2</size></box></geometry><pose>-5 0 1.6 0 0 0</pose><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual>
      <collision name="right_col"><geometry><box><size>0.10 8 3.2</size></box></geometry><pose>5 0 1.6 0 0 0</pose></collision>
      <visual name="right_vis"><geometry><box><size>0.10 8 3.2</size></box></geometry><pose>5 0 1.6 0 0 0</pose><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual>
      <visual name="safety_zone"><pose>0 1.55 0.006 0 0 0</pose><geometry><box><size>3.2 0.05 0.01</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Yellow</name></script></material></visual>
    </link></model>


    <include><uri>model://workbench</uri><name>central_workbench</name><pose>0.2 0.65 0 0 0 0</pose></include>
    <include><uri>model://workbench</uri><name>assembly_bench</name><pose>-2.7 2.1 0 0 0 0</pose></include>
    <include><uri>model://storage_shelf</uri><name>parts_shelf</name><pose>3.8 -2.7 0 0 0 0</pose></include>
    <include><uri>model://small_box</uri><name>small_box</name><pose>3.95 -2.65 0.48 0 0 0</pose></include>
    <include><uri>model://small_box</uri><name>small_box2</name><pose>3.5 -2.65 0.48 0 0 0</pose></include>
    <include><uri>model://tool_cabinet</uri><name>tool_cabinet_left</name><pose>-3.8 -2.8 0 0 0 0</pose></include>
    <include><uri>model://parts_bin</uri><name>parts_bin</name><pose>3.55 -2.65 1.05 0 0 3.14</pose></include>
    <include><uri>model://toolbox</uri><name>toolbox</name><pose>3.65 -2.65 1.72 0 0 0</pose></include>
    <include><uri>model://pegboard</uri><name>back_pegboard</name><pose>0 -3.75 0.95 0 0 0</pose></include>

    <include><uri>model://paint_can</uri><name>paint_can</name><pose>1.2 0.9 0.87 0 0 1.57</pose></include>
    <include><uri>model://paint_brush</uri><name>paint_brush</name><pose>0.81 0.93 0.88 3.14 0 1.3</pose></include>
    <include><uri>model://048_hammer</uri><name>hammer</name><pose>-0.55 0.7 0.887 0 0 0.9</pose></include>
    <include><uri>model://042_adjustable_wrench</uri><name>wrench</name><pose>-0.15 0.4 0.880 0 0 2.8</pose></include>
    <include><uri>model://043_phillips_screwdriver</uri><name>screwdriver</name><pose>-0.0 0.28 0.87 0 0 4</pose></include>
    <include><uri>model://035_power_drill</uri><name>power_drill</name><pose>0.4 0.42 0.95 1.59 0 -2.9</pose></include>
    <include><uri>model://037_scissors</uri><name>scissors</name><pose>-0.43 1 0.884 0 0 0.1</pose></include>
    <include><uri>model://050_medium_clamp</uri><name>medium_clamp</name><pose>-0.15 0.82 0.870 0 0 0</pose></include>
    <include><uri>model://050_medium_clamp</uri><name>medium_clamp2</name><pose>-0.15 0.7 0.870 0 0 3.14</pose></include>
    <include><uri>model://036_wood_block</uri><name>wood_block</name><pose>0.25 0.82 0.93 0 0 0.2</pose></include>
    <include><uri>model://036_wood_block</uri><name>wood_block2</name><pose>0.12 0.82 0.93 0 0 0.2</pose></include>
    <include><uri>model://m10_bolt_45</uri><name>bolt1</name><pose>0.55 0.82 0.9 1.5 0 0.2</pose></include>
    <include><uri>model://m10_bolt_45</uri><name>bolt2</name><pose>0.52 0.8 0.9 1.3 0 0.1</pose></include>
    <include><uri>model://m10_bolt_45</uri><name>bolt3</name><pose>0.50 0.82 0.9 1.57 0 -0.1</pose></include>
    <include><uri>model://m10_bolt_45</uri><name>bolt4</name><pose>0.46 0.79 0.9 1.7 0 -0.3</pose></include>
    <include><uri>model://m10_bolt_45</uri><name>bolt5</name><pose>0.53 0.84 0.9 1.57 0 3</pose></include>
    <include><uri>model://m10_bolt_45</uri><name>bolt6</name><pose>0.48 0.84 0.9 1.7 0 2.8</pose></include>
    <include><uri>model://m10_hex_nut</uri><name>nut1</name><pose>0.6 0.82 0.89 0 0 0</pose></include>
    <include><uri>model://m10_hex_nut</uri><name>nut2</name><pose>0.6 0.78 0.89 0 0 0</pose></include>
    <include><uri>model://m10_hex_nut</uri><name>nut3</name><pose>0.58 0.8 0.89 0 0 0</pose></include>
    <include><uri>model://m10_hex_nut</uri><name>nut4</name><pose>0.61 0.8 0.89 0 0 0</pose></include>
    <include><uri>model://m10_hex_nut</uri><name>nut5</name><pose>0.63 0.82 0.89 0 0 0</pose></include>
    <include><uri>model://m10_hex_nut</uri><name>nut6</name><pose>0.61 0.78 0.89 0 0 0</pose></include>
    <include><uri>model://marker_pen</uri><name>marker_pen</name><pose>-0.73 0.92 0.884 0 0 0.1</pose></include>
    <include><uri>model://wood_board</uri><name>wood_board</name><pose>-0.67 0.4 0.9 0 0 0.0</pose></include>
    <include><uri>model://metal_plate</uri><name>metal_plate</name><pose>-0.66 0.4 0.931 0 0 0</pose></include>
    <include><uri>model://metal_tray</uri><name>metal_tray</name><pose>1 0.38 0.88 0. 0 0</pose></include>

    <!-- Piedistallo robot -->
    <model name="robot_pedestal"><static>true</static><pose>0.2 0.0 0.0 0 0 0</pose>
      <link name="column"><pose>0 0 0.385 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.22 0.22 0.77</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.22 0.22 0.77</size></box></geometry>
          <material><ambient>0.35 0.35 0.38 1</ambient><diffuse>0.40 0.40 0.43 1</diffuse></material></visual>
      </link>
      <link name="base"><pose>0.07 0 0.025 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.40 0.40 0.05</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.40 0.40 0.05</size></box></geometry>
          <material><ambient>0.25 0.25 0.28 1</ambient><diffuse>0.30 0.30 0.33 1</diffuse></material></visual>
      </link>
    </model>
    <gui fullscreen="0"><camera name="user_camera"><pose>7 6 5.5 0 0.45 -2.35</pose><view_controller>orbit</view_controller></camera></gui>


    <!-- ================================================================
         OVERVIEW CAMERA - visuale 3/4 sul bancone da destra-davanti.
         Da calibrare: python3 scripts/calibrate_overview_cam.py -world kitchen
    ================================================================ -->
    <model name="overview_camera">
      <static>true</static>
      <pose>0.23 2.15 2.41 0 0.9 -1.57</pose>
      <link name="camera_link">
        <visual name="vis">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <material><ambient>0 0 0.8 1</ambient><diffuse>0 0 0.8 1</diffuse></material>
        </visual>
        <sensor name="overview_camera" type="camera">
          <update_rate>10</update_rate>
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image><width>1280</width><height>960</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>7.0</far></clip>
          </camera>
          <plugin name="overview_camera_plugin" filename="libgazebo_ros_camera.so">
            <ros>
              <remapping>~/image_raw:=/overview_camera/image_raw</remapping>
              <remapping>~/camera_info:=/overview_camera/camera_info</remapping>
            </ros>
            <camera_name>overview_camera</camera_name>
            <frame_name>overview_camera_link</frame_name>
          </plugin>
        </sensor>
      </link>
    </model>

  </world>
</sdf>
